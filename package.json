{
  "name": "my-apps",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/stop-prior-next-dev.mjs && next dev --webpack",
    "dev:turbo": "node scripts/stop-prior-next-dev.mjs && next dev",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "NODE_OPTIONS='--require ./scripts/resolve-typescript6.cjs' eslint",
    "test": "node scripts/run-unit-tests.mjs",
    "test:module-mocks": "tsx --experimental-test-module-mocks --import ./scripts/test-env.mjs --test lib/api-http-transport.test.ts lib/api-investment-context.test.ts lib/investment-rest-hardening.test.ts lib/http-idempotency-route.test.ts",
    "test:e2e": "nice -n 15 playwright test",
    "test:e2e:ui": "nice -n 15 playwright test --ui",
    "typecheck": "node ./node_modules/typescript/lib/tsc.js --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:reset": "node scripts/reset-local-db-schema.mjs",
    "db:baseline": "node scripts/baseline-drizzle-migrations.mjs",
    "db:migrate": "node scripts/run-drizzle-migrate.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:recompute-balances": "node scripts/recompute-money-balances.mjs",
    "db:backfill-finance-unify": "node scripts/backfill-finance-unify.mjs",
    "api:export-schema": "node scripts/export-graphql-schema.mjs",
    "docker:up": "docker compose --env-file .env up --build",
    "docker:down": "docker compose --env-file .env down",
    "docker:db": "docker compose -f docker-compose-db.yml up -d",
    "docker:db:down": "docker compose -f docker-compose-db.yml down"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@escape.tech/graphql-armor-max-aliases": "^2.6.2",
    "@escape.tech/graphql-armor-max-depth": "^2.4.2",
    "@escape.tech/graphql-armor-max-tokens": "^2.5.1",
    "@graphql-tools/schema": "^11",
    "@graphql-yoga/plugin-response-cache": "^4.0.1",
    "@tanstack/react-query": "^5.104.5",
    "@visx/curve": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/responsive": "^4.0.0",
    "@visx/sankey": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "graphql": "^17.0.2",
    "graphql-request": "^7.4.0",
    "graphql-scalars": "^2.0.1",
    "graphql-yoga": "^6.0.1",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "passkit-generator": "^3.7.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "web-push": "^3.6.7",
    "yahoo-finance2": "^4.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@next/bundle-analyzer": "^16.4.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "^3.6.4",
    "@typescript/typescript6": "^6.0.2",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "node-forge": "^1.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@next/swc-darwin-arm64": "16.4.3"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1",
      "joi": "17.13.7",
      "graphql": "^17.0.2"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "fsevents",
      "sharp",
      "unrs-resolver"
    ]
  }
}
