{
  "name": "my-apps",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=12"
  },
  "scripts": {
    "dev": "node scripts/stop-prior-next-dev.mjs && next dev --webpack",
    "dev:turbo": "node scripts/stop-prior-next-dev.mjs && next dev",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "NODE_OPTIONS='--require ./scripts/resolve-typescript6.cjs' eslint",
    "test": "tsx --import ./scripts/test-env.mjs --test \"lib/**/*.test.ts\" \"components/**/*.test.ts\"",
    "typecheck": "node ./node_modules/typescript/lib/tsc.js --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:reset": "node scripts/reset-local-db-schema.mjs",
    "db:baseline": "node scripts/baseline-drizzle-migrations.mjs",
    "db:migrate": "node scripts/run-drizzle-migrate.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:recompute-balances": "node scripts/recompute-money-balances.mjs",
    "db:backfill-finance-unify": "node scripts/backfill-finance-unify.mjs",
    "api:export-schema": "node scripts/export-graphql-schema.mjs",
    "docker:up": "docker compose --env-file .env up --build",
    "docker:down": "docker compose --env-file .env down",
    "docker:db": "docker compose -f docker-compose-db.yml up -d",
    "docker:db:down": "docker compose -f docker-compose-db.yml down"
  },
  "dependencies": {
    "@escape.tech/graphql-armor-max-aliases": "^2.6.2",
    "@escape.tech/graphql-armor-max-depth": "^2.4.2",
    "@escape.tech/graphql-armor-max-tokens": "^2.5.1",
    "@graphql-yoga/plugin-response-cache": "^3.23.2",
    "@tanstack/react-query": "^5.101.4",
    "@visx/curve": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/responsive": "^4.0.0",
    "@visx/sankey": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "csv-parse": "^7.0.1",
    "d3-shape": "^3.2.0",
    "drizzle-orm": "^0.45.2",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "graphql-scalars": "^1.25.0",
    "graphql-yoga": "^5.21.2",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.9",
    "rate-limiter-flexible": "^11.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7",
    "yahoo-finance2": "^4.0.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@next/swc-darwin-arm64": "16.2.12"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@next/bundle-analyzer": "^16.2.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "@typescript/typescript6": "^6.0.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "10.8.0",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
